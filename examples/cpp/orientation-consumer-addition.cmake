# Qualified SDK002 consumer shipped unchanged; installed imagejxx::core only.
add_executable(imagejxx_axis_range_orientation_example "${CMAKE_CURRENT_LIST_DIR}/axis_range_orientation.cpp")
target_link_libraries(imagejxx_axis_range_orientation_example PRIVATE imagejxx::core)
target_compile_features(imagejxx_axis_range_orientation_example PRIVATE cxx_std_17)
if(MSVC)
  target_compile_options(imagejxx_axis_range_orientation_example PRIVATE /fp:strict)
elseif(CMAKE_CXX_COMPILER_ID MATCHES "GNU|Clang")
  target_compile_options(imagejxx_axis_range_orientation_example PRIVATE -fno-fast-math -ffp-contract=off)
endif()
set(IMAGEJXX_ORIENTATION_CAPTURE_DIR "${CMAKE_CURRENT_BINARY_DIR}/orientation-observations" CACHE PATH "Fresh compact SDK observation directory")
if(BUILD_TESTING)
  add_test(NAME imagejxx_axis_range_orientation_example COMMAND imagejxx_axis_range_orientation_example --output-dir "${IMAGEJXX_ORIENTATION_CAPTURE_DIR}")
  set_tests_properties(imagejxx_axis_range_orientation_example PROPERTIES TIMEOUT 120)
endif()
