# Allocate a fresh fixture destination for every invocation, retaining failed
# and successful file observations. Never remove or reuse an earlier run.
if(NOT DEFINED TEST_EXECUTABLE OR NOT DEFINED WORK_ROOT)
  message(FATAL_ERROR "TEST_EXECUTABLE and WORK_ROOT are required")
endif()
if(NOT DEFINED TEST_TIMEOUT_SECONDS)
  set(TEST_TIMEOUT_SECONDS 25)
endif()
if(NOT TEST_TIMEOUT_SECONDS MATCHES "^[1-9][0-9]*$" OR TEST_TIMEOUT_SECONDS GREATER 60)
  message(FATAL_ERROR "TEST_TIMEOUT_SECONDS must be an integer from 1 through 60")
endif()
file(MAKE_DIRECTORY "${WORK_ROOT}")
string(RANDOM LENGTH 24 ALPHABET 0123456789abcdef run_id)
set(work_path "${WORK_ROOT}/${run_id}")
message(STATUS "Owned fixture output: ${work_path}")
set(fixture_arguments "${work_path}")
if(DEFINED TEST_ARGUMENT)
  list(APPEND fixture_arguments "${TEST_ARGUMENT}")
endif()
execute_process(COMMAND "${TEST_EXECUTABLE}" ${fixture_arguments}
  RESULT_VARIABLE test_result TIMEOUT ${TEST_TIMEOUT_SECONDS})
if(NOT test_result STREQUAL "0")
  message(FATAL_ERROR "Fixture test failed: ${test_result}")
endif()
