@PACKAGE_INIT@
include(CMakeFindDependencyMacro)
find_dependency(Threads)
include("${CMAKE_CURRENT_LIST_DIR}/imagejxxTargets.cmake")
set(imagejxx_core_FOUND TRUE)
foreach(component IN LISTS imagejxx_FIND_COMPONENTS)
  if(component STREQUAL "io" AND EXISTS "${CMAKE_CURRENT_LIST_DIR}/imagejxxIoTargets.cmake")
    if(imagejxx_FIND_REQUIRED_io)
      find_dependency(TIFF 4.7.1 EXACT)
    else()
      find_package(TIFF 4.7.1 EXACT QUIET)
      if(NOT TIFF_FOUND)
        set(imagejxx_io_FOUND FALSE)
        continue()
      endif()
    endif()
    include("${CMAKE_CURRENT_LIST_DIR}/ReviewedTiffRuntime.cmake")
    imagejxx_checked_tiff_runtime(IMAGEJXX_IO_RUNTIME_FILES)
    include("${CMAKE_CURRENT_LIST_DIR}/imagejxxIoTargets.cmake")
    set(imagejxx_io_FOUND TRUE)
  elseif(NOT component STREQUAL "core")
    set(imagejxx_${component}_FOUND FALSE)
    set(imagejxx_NOT_FOUND_MESSAGE "Requested imagejxx component '${component}' is not installed. This package provides core; scientific IO requires its own qualified target/export.")
  endif()
endforeach()
check_required_components(imagejxx)

