include_guard(GLOBAL)
include("${CMAKE_CURRENT_LIST_DIR}/ReviewedTiffRuntime.cmake")

# Only an explicit source-preparation profile selects this route. The original
# ten-file Windows policy remains the default and retains its own exact pins.
function(imagejxx_checked_selected_tiff_runtime output)
  if(NOT IMAGEJXX_CI_SOURCE_PROFILE)
    imagejxx_checked_tiff_runtime(files)
    set(${output} "${files}" PARENT_SCOPE)
    set(IMAGEJXX_TIFF_RUNTIME_VERIFY_SCRIPT "${IMAGEJXX_TIFF_RUNTIME_VERIFY_SCRIPT}" PARENT_SCOPE)
    return()
  endif()
  if(CMAKE_CROSSCOMPILING OR NOT CMAKE_SIZEOF_VOID_P EQUAL 8)
    message(FATAL_ERROR "Source dependency profiles require a native 64-bit build")
  endif()
  if(NOT CMAKE_BUILD_TYPE STREQUAL "Release" OR CMAKE_CONFIGURATION_TYPES)
    message(FATAL_ERROR "Source dependency profiles require a single-configuration Release consumer")
  endif()
  if(IMAGEJXX_CI_SOURCE_PROFILE STREQUAL "windows-x64-ci-dynamic-source-001")
    if(NOT WIN32 OR NOT MSVC OR NOT CMAKE_CXX_COMPILER_ID STREQUAL "MSVC" OR
       NOT CMAKE_CXX_COMPILER_ARCHITECTURE_ID MATCHES "^(x64|X64|AMD64|x86_64)$")
      message(FATAL_ERROR "Windows source profile requires native MSVC")
    endif()
  elseif(IMAGEJXX_CI_SOURCE_PROFILE MATCHES "^macos-(arm64|x86_64)-ci-static-source-001$")
    if(NOT APPLE)
      message(FATAL_ERROR "macOS source profile requires a native Apple host")
    endif()
    string(REGEX REPLACE "^macos-(arm64|x86_64)-ci-static-source-001$" "\\1" expected_arch "${IMAGEJXX_CI_SOURCE_PROFILE}")
    if(NOT CMAKE_HOST_SYSTEM_PROCESSOR STREQUAL expected_arch OR
       (CMAKE_OSX_ARCHITECTURES AND NOT CMAKE_OSX_ARCHITECTURES STREQUAL expected_arch))
      message(FATAL_ERROR "macOS source dependency architecture differs from the native build")
    endif()
  else()
    message(FATAL_ERROR "Unknown source dependency profile")
  endif()
  set(concrete TIFF::TIFF)
  get_target_property(kind TIFF::TIFF TYPE)
  if(kind STREQUAL "INTERFACE_LIBRARY")
    get_target_property(forward TIFF::TIFF INTERFACE_LINK_LIBRARIES)
    if(NOT forward STREQUAL "TIFF::tiff" OR NOT TARGET TIFF::tiff)
      message(FATAL_ERROR "Unsupported TIFF interface wrapper")
    endif()
    set(concrete TIFF::tiff)
  endif()
  get_target_property(library ${concrete} IMPORTED_IMPLIB_RELEASE)
  if(NOT library)
    get_target_property(library ${concrete} IMPORTED_LOCATION_RELEASE)
  endif()
  if(NOT library)
    get_target_property(library ${concrete} IMPORTED_LOCATION)
  endif()
  if(NOT library OR NOT EXISTS "${library}")
    message(FATAL_ERROR "Selected TIFF import is unavailable")
  endif()
  get_filename_component(library "${library}" REALPATH)
  get_filename_component(libdir "${library}" DIRECTORY)
  get_filename_component(prefix "${libdir}" DIRECTORY)
  get_target_property(includes ${concrete} INTERFACE_INCLUDE_DIRECTORIES)
  if(NOT includes STREQUAL "${prefix}/include")
    message(FATAL_ERROR "Source TIFF headers/import library must share the verified prefix")
  endif()
  set(guard "${CMAKE_CURRENT_FUNCTION_LIST_DIR}")
  if(EXISTS "${guard}/../scripts/verify_ci_platform_dependencies.py")
    set(verifier "${guard}/../scripts/verify_ci_platform_dependencies.py")
    set(catalog "${guard}/../licenses/ci-linux-source-dependencies.json")
    set(builder "${guard}/../scripts/ci_platform_dependencies.py")
  else()
    set(verifier "${guard}/verify_ci_platform_dependencies.py")
    set(catalog "${guard}/ci-linux-source-dependencies.json")
    set(builder "${guard}/ci_platform_dependencies.py")
  endif()
  find_package(Python3 3.10 REQUIRED COMPONENTS Interpreter)
  set(generated "${CMAKE_CURRENT_BINARY_DIR}/imagejxx-source-dependencies.cmake")
  execute_process(COMMAND "${Python3_EXECUTABLE}" -I -B "${verifier}"
    --prefix "${prefix}" --profile "${IMAGEJXX_CI_SOURCE_PROFILE}"
    --catalog "${catalog}" --builder "${builder}" --tiff-link "${library}" --output "${generated}"
    RESULT_VARIABLE status OUTPUT_VARIABLE stdout ERROR_VARIABLE stderr)
  if(NOT status STREQUAL "0")
    message(FATAL_ERROR "Source dependency preparation is invalid: ${stdout}${stderr}")
  endif()
  include("${generated}")
  set(${output} "${IMAGEJXX_IO_RUNTIME_FILES}" PARENT_SCOPE)
  set(IMAGEJXX_TIFF_RUNTIME_VERIFY_SCRIPT "${IMAGEJXX_TIFF_RUNTIME_VERIFY_SCRIPT}" PARENT_SCOPE)
  set(IMAGEJXX_CI_SOURCE_DEP_PREFIX "${IMAGEJXX_CI_SOURCE_DEP_PREFIX}" PARENT_SCOPE)
endfunction()

# FindPNG prefers the unversioned archive alias. These explicit Mac profiles
# bind the canonical archive/header roles before discovery; the full target
# origin checks below still validate the actual imported target afterward.
function(imagejxx_bind_source_png prefix)
  if(NOT IMAGEJXX_CI_SOURCE_PROFILE MATCHES "^macos-(arm64|x86_64)-ci-static-source-001$")
    return()
  endif()
  set(expected "${prefix}/lib/libpng16.a")
  set(headers "${prefix}/include")
  if(NOT EXISTS "${expected}" OR IS_DIRECTORY "${expected}" OR IS_SYMLINK "${expected}" OR
     NOT EXISTS "${headers}/png.h" OR IS_DIRECTORY "${headers}/png.h" OR IS_SYMLINK "${headers}/png.h")
    message(FATAL_ERROR "Selected source PNG canonical archive/header is unavailable")
  endif()
  get_filename_component(actual "${expected}" REALPATH)
  get_filename_component(actual_headers "${headers}" REALPATH)
  if(NOT actual STREQUAL expected OR NOT actual_headers STREQUAL headers)
    message(FATAL_ERROR "Selected source PNG canonical paths contain a linked ancestor")
  endif()
  foreach(variable IN ITEMS PNG_LIBRARY_RELEASE PNG_LIBRARY)
    if(DEFINED ${variable} AND NOT "${${variable}}" STREQUAL "${expected}")
      message(FATAL_ERROR "Selected source PNG library override differs: ${variable}")
    endif()
  endforeach()
  if(DEFINED PNG_PNG_INCLUDE_DIR AND NOT PNG_PNG_INCLUDE_DIR STREQUAL headers)
    message(FATAL_ERROR "Selected source PNG header override differs")
  endif()
  set(PNG_LIBRARY_RELEASE "${expected}" PARENT_SCOPE)
  set(PNG_LIBRARY "${expected}" PARENT_SCOPE)
  set(PNG_PNG_INCLUDE_DIR "${headers}" PARENT_SCOPE)
endfunction()

# Find modules may select an exact-version library outside CMAKE_PREFIX_PATH.
# Bind the actual desktop targets and include paths to the verified delivery.
function(imagejxx_check_source_desktop_dependencies prefix)
  if(NOT IMAGEJXX_CI_SOURCE_PROFILE)
    return()
  endif()
  foreach(pair IN ITEMS "ZLIB::ZLIB|zlib.lib|zlib1.dll|libz.a"
                        "PNG::PNG|libpng16.lib|libpng16.dll|libpng16.a"
                        "glfw|glfw3dll.lib|glfw3.dll|libglfw3.a")
    string(REPLACE "|" ";" fields "${pair}")
    list(GET fields 0 dependency)
    if(NOT TARGET ${dependency})
      message(FATAL_ERROR "Missing selected source desktop dependency: ${dependency}")
    endif()
    set(location "")
    set(import "")
    foreach(configuration IN ITEMS RELEASE NOCONFIG "")
      if(configuration)
        set(suffix "_${configuration}")
      else()
        set(suffix "")
      endif()
      if(NOT location)
        get_target_property(location ${dependency} IMPORTED_LOCATION${suffix})
      endif()
      if(NOT import)
        get_target_property(import ${dependency} IMPORTED_IMPLIB${suffix})
      endif()
    endforeach()
    get_target_property(kind ${dependency} TYPE)
    if(WIN32)
      list(GET fields 1 link)
      list(GET fields 2 runtime)
      if(kind STREQUAL "SHARED_LIBRARY")
        if(NOT import STREQUAL "${prefix}/lib/${link}" OR
           NOT location STREQUAL "${prefix}/bin/${runtime}")
          message(FATAL_ERROR "Selected source desktop library differs: ${dependency}")
        endif()
      elseif(NOT location STREQUAL "${prefix}/lib/${link}")
        message(FATAL_ERROR "Selected source desktop link differs: ${dependency}")
      endif()
    else()
      list(GET fields 3 link)
      if(NOT kind STREQUAL "STATIC_LIBRARY" AND NOT kind STREQUAL "UNKNOWN_LIBRARY")
        message(FATAL_ERROR "Selected source desktop library must be static: ${dependency}")
      endif()
      if(NOT location STREQUAL "${prefix}/lib/${link}")
        message(FATAL_ERROR "Selected source desktop link differs: ${dependency}")
      endif()
    endif()
    get_target_property(headers ${dependency} INTERFACE_INCLUDE_DIRECTORIES)
    if(NOT headers)
      message(FATAL_ERROR "Missing selected source desktop headers: ${dependency}")
    endif()
    foreach(directory IN LISTS headers)
      if(NOT directory STREQUAL "${prefix}/include")
        message(FATAL_ERROR "Selected source desktop headers differ: ${dependency}")
      endif()
    endforeach()
  endforeach()
  get_target_property(json_headers nlohmann_json::nlohmann_json INTERFACE_INCLUDE_DIRECTORIES)
  if(NOT json_headers STREQUAL "${prefix}/include" OR
     NOT IMAGEJXX_STB_INCLUDE_DIR STREQUAL "${prefix}/include")
    message(FATAL_ERROR "Selected source JSON/STB headers differ")
  endif()
endfunction()
