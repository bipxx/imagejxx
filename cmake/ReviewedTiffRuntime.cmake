include_guard(GLOBAL)
include("${CMAKE_CURRENT_LIST_DIR}/TiffRuntimeManifest.cmake")

# The Windows release closure is selected by the actual TIFF import library,
# never by the unrelated PNG/ZLIB prefix or an aggregate package list.
function(imagejxx_checked_tiff_runtime output)
  if(NOT WIN32)
    set(${output} "" PARENT_SCOPE)
    return()
  endif()
  if(NOT TARGET TIFF::TIFF)
    message(FATAL_ERROR "Reviewed TIFF runtime requires TIFF::TIFF")
  endif()
  get_target_property(library TIFF::TIFF IMPORTED_IMPLIB_RELEASE)
  if(NOT library)
    get_target_property(library TIFF::TIFF IMPORTED_LOCATION_RELEASE)
  endif()
  if(NOT library)
    get_target_property(library TIFF::TIFF IMPORTED_LOCATION)
  endif()
  if(NOT library OR NOT EXISTS "${library}")
    message(FATAL_ERROR "Reviewed TIFF release import library is missing")
  endif()
  get_filename_component(library "${library}" REALPATH)
  get_filename_component(libdir "${library}" DIRECTORY)
  get_filename_component(prefix "${libdir}" DIRECTORY)
  if(NOT library STREQUAL "${prefix}/lib/tiff.lib")
    message(FATAL_ERROR "TIFF import library is outside the reviewed layout")
  endif()
  get_target_property(includes TIFF::TIFF INTERFACE_INCLUDE_DIRECTORIES)
  if(NOT includes STREQUAL "${prefix}/include")
    message(FATAL_ERROR "TIFF headers and runtime must use the same reviewed prefix")
  endif()
  set(runtime)
  set(checks)
  foreach(row IN LISTS IMAGEJXX_TIFF_REVIEWED_FILES)
    string(REPLACE "|" ";" fields "${row}")
    list(GET fields 0 kind)
    list(GET fields 1 relative)
    list(GET fields 2 expected)
    list(GET fields 3 expected_size)
    set(path "${prefix}/${relative}")
    if(NOT EXISTS "${path}" OR IS_DIRECTORY "${path}" OR IS_SYMLINK "${path}")
      message(FATAL_ERROR "Reviewed TIFF dependency missing/not regular: ${relative}")
    endif()
    get_filename_component(resolved "${path}" REALPATH)
    if(NOT resolved STREQUAL path)
      message(FATAL_ERROR "Reviewed TIFF dependency must stay in its prefix: ${relative}")
    endif()
    file(SIZE "${path}" actual_size)
    file(SHA256 "${path}" actual)
    if(NOT actual STREQUAL expected OR NOT actual_size EQUAL expected_size)
      message(FATAL_ERROR "Reviewed TIFF dependency fingerprint changed: ${relative}")
    endif()
    if(kind STREQUAL "runtime")
      list(APPEND runtime "${path}")
    endif()
    # Revalidate all selected inputs, not just DLLs, before build/delivery.
    string(APPEND checks "\nif(NOT EXISTS \"${path}\" OR IS_SYMLINK \"${path}\")\n  message(FATAL_ERROR \"Reviewed TIFF dependency missing: ${relative}\")\nendif()\nfile(SHA256 \"${path}\" actual)\nif(NOT actual STREQUAL \"${expected}\")\n  message(FATAL_ERROR \"Reviewed TIFF dependency changed: ${relative}\")\nendif()\n")
  endforeach()
  # TIFF and PNG may both need zlib, but cannot silently mix different builds.
  if(TARGET ZLIB::ZLIB)
    get_target_property(zlib ZLIB::ZLIB IMPORTED_LOCATION_RELEASE)
    if(NOT zlib)
      get_target_property(zlib ZLIB::ZLIB IMPORTED_LOCATION)
    endif()
    if(NOT zlib OR NOT EXISTS "${zlib}")
      message(FATAL_ERROR "Reviewed TIFF closure requires an identified ZLIB import library")
    endif()
    file(SHA256 "${zlib}" selected_zlib)
    file(SHA256 "${prefix}/lib/zlib.lib" expected_zlib)
    if(NOT selected_zlib STREQUAL expected_zlib)
      message(FATAL_ERROR "TIFF and ZLIB select different reviewed runtime ABIs")
    endif()
  endif()
  set(verifier "${CMAKE_CURRENT_BINARY_DIR}/imagejxx-tiff-runtime-verify.cmake")
  file(WRITE "${verifier}" "# Exact reviewed TIFF runtime boundary checks.${checks}")
  set(IMAGEJXX_TIFF_RUNTIME_VERIFY_SCRIPT "${verifier}" PARENT_SCOPE)
  set(${output} "${runtime}" PARENT_SCOPE)
endfunction()
