  "source_authoring_and_derivation": {
    "native": "Independently authored additive V2 command sibling and metadata-only descriptor; private shared V1 source/layout helpers factored from existing owned implementation. Existing integer sampler/affine implementation and closed public two-type V1 contract remain existing project material; no upstream Java algorithm/source incorporated.",
    "python": "Thin native forwards reuse existing callback/GIL bridge; exports only additive native entry points. New fresh canonical consumer uses passed actual installed modules and DTOs; NumPy constructs owned inputs and serializes actual declared bytes only.",
    "shared_ui": "Owned shared ImGui form/current-source capture/admission/recording/replay/rebind/staged-attachment integration. Desktop legacy workflow validates V2 then retains explicit typed-workflow refusal. No Qt or second Python geometry implementation.",
    "sdk_and_tests": "Owned analytic TCZYXS formula, literal typed/quiet-bit/calibration/world/refusal fixtures, SDK actual-value serializer, native/host/API/paired readers and disclosed API setup. Public-only SDK uses project headers+stdlib; no expected/PASS-backed actual values.",
    "observation_and_capture": "Adapted existing owned HeadlessInputSession/publication probe/lossless transport/SHA/Win32-owned-process facilities. O12 real scientific Gaussian busy setup and candidate failure setup are explicitly scoped diagnostic stimuli. Additive bounded capture profile retains old profiles; no external reference asset/model/font or new package.",
    "reference": "Reuse exact adopted orientation reference review identity; do not reopen ImageJ source/license/archive/JAR/classpath. Its reference-only tools,16 reviewed members and96 observation scope are unchanged; owned affine/time/XY/F64/RGBA/adapter/UI claims remain owned.",
    "qualified_reader_repair": {
      "changed_functions": [
        "_inputs",
        "_workflow_rebind_case"
      ],
      "added_functions": [
        "_reader_source_repair"
      ],
      "added_stdlib_imports": [
        "ast",
        "base64",
        "xml.etree.ElementTree as ET"
      ],
      "wire_boundary": "NativeV3 stores canonical base64 F64LE planes; actual observation stores F64LE hex. Decode actual saved-wire base64, enforce30x504-byte bounds, compare all bytes against independently observed source bytes. No pixel processing, expected-value rewrite or tolerance change.",
      "origin_guard": "Explicitly admit exact original captured source plus qualified live source through pinned repair manifest. Original origin reader_source names logical live path; its retained bytes/hash are checked against captured old bytes rather than rereading intentionally changed live bytes.",
      "preserved": "Original22 case assertion ASTs, global constants/dispatch/membership and O09 unchanged prefix/suffix preserved; only exact wire encoding comparison and source guard changed.",
      "incorporated_material": "Owned pure reader and metadata/byte decoding over existing project/nativeV3 format; only Python stdlib modules added, no new dependency/runtime/model/font/image/Java/source material."
    }
  },
