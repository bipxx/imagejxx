  "aspects": {
    "implemented": "Native per-click counter/position helper, strict Python interface, two consumed Settings/Preferences keys and aligned ordinary Point/Multipoint creation.",
    "verified": "507 unique focused Windows product cases ultimately pass,one optional OpenGL skip; two native controls and six installed SDK clients per Windows/Linux platform.",
    "integrated": "Actual preferences/counter changes between clicks, singleton and classic-Z-stack point/multipoint creation, persisted bytes and reopened Editor settings in both Windows hosts.",
    "release_ready": false
  },
  "contract": {
    "api": "point_creation_annotation(extent,position,counter=0,capture_position=True)",
    "keys": {
      "point_counter": {
        "default": 0,
        "range": [
          0,
          99
        ],
        "consumer": "Each new ordinary Multipoint vertex; single-point uses counter0."
      },
      "point_capture_position": {
        "default": true,
        "validation": "Strict Boolean",
        "consumer": "Each new ordinary Point/Multipoint vertex; only multi-plane datasets bind current T/C/Z."
      }
    },
    "capture": "Validate position even when capture off. Freeze counter/position per delivered click, never at final completion. Default changes do not retag earlier vertices. Singleton/capture-off remains unbound.",
    "state": "Metadata built once at completion; allzero/unbound ordinary defaults stay untagged. Existing selection/Previous/session/ROI/export metadata owners unchanged. No new codec/version/controller.",
    "admission": "At most100000 vertices and conservative configured working/vertex allowance before multipoint append. Reserve carriers geometrically; copy next JSON point and all throwing reserves before aligned append. Terminal reset releases typed buffer. This is draft staging admission, not whole-process/RSS accounting.",
    "compatibility": "Numeric raster point_size remains default8,range1..256. Capture-position setting is distinct from ImageJ show-on-all-slices display policy. Existing metadata/property edits stay explicit.",
    "recording": "Ordinary point-creation executable recording remains T12/P4; retaining selection/session metadata does not close replay."
  },
