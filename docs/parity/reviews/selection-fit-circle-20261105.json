  "task": "T06/G018 Fit Circle, area and point branches",
  "base_commit": "c94c79f",
  "command_candidate": "R-b74287ebd677e483d1337005",
  "state": {
    "implemented": "Public C++/Python Fit Circle and estimate APIs; occupied-area/centroid and Pratt point branches; existing conversion controls, explicit point-data loss/history/V4 replay; captured prepared-task worker for area planning/fitting/command preparation.",
    "verified": "52 pinned observations including6 refusals;679 distinct affected Windows Python cases pass, with2 same-ID focused review checks for width and callback-triggered cancellation. Windows/Linux native core and installed Windows public C++ consumer pass. Both actual Windows ImGui host branches, plus10 gated area-job scenarios, pass. All behavioral verification attempts pass on first run. Final creator-status allocation correction passes4 same-ID Python UI/editor cases and native UI/lifecycle regressions; unchanged geometry/Linux/SDK evidence reused.",
    "integrated": "Editable ellipse after both area/point menu routes; loss cancel/consent, stale review/error acknowledgement, Undo/Redo/workspace and strict replay refusal/explicit rebind. Area jobs return before publication; queued/running/ready cancel, source/pose/owner/cap/recording changes and entry resource refusal produce no history/record. Processing performs zero provider plane reads and retires scheduler/render working storage.",
    "release_ready": false
  },
  "contract": {
    "api": [
      "estimate_fit_circle_selection(selection,width,height,limits)",
      "fit_circle_selection(selection,width,height,discard_point_metadata,limits,control)"
    ],
    "area": "Canvas-clipped occupied pixels, centroid of pixel centers and radius sqrt(count/pi). Reuse Selection.mask/shape planner, including holes/packed regions/native rotated geometry. Round final origin and diameter to integer ellipse bounds; do not fit area boundary vertices.",
    "points": "At least3 point/segmented-line/angle vertices; locally normalized Float32 then integer getPolygon coordinates. Independent Pratt moment equation with at most20 Newton updates and explicit singular/nonconvergent refusal. Straight Line refuses.",
    "refusal": "Empty canvas area, invalid input, inadequate resource/vertex limits, nonfinite/singular/nonconvergent fit and integer output overflow refuse without source mutation/publication. Native nonconvergence refusal is stricter than legacy fallback.",
    "metadata": "Retain generic/opaque attributes and width; explicit discard of typed point annotations/style. History restores original metadata. Pixels/calibration unchanged; statistics in pixel space.",
    "worker": "Existing startControlled prepared-task lane and scheduler; private JobResult carries existing resolved V4 replacement and retained capture lease. Full effective cap reservation conservatively covers sequential geometry/command phases. Capture allowance4*declared snapshot bytes is withheld from each phase. Creator uses existing publishSelectionCreation while Job is Publishing, with owner/revisions/XY-TCZ/cap/recording guards. No new scheduler/controller/common public struct/record schema.",
    "python": "Cheap borrowed geometry admission before source copy; release GIL before full circle planner/fit. Explicit estimate may traverse geometry; no duplicate full planner under the GIL in the processing binding.",
    "replay": "V4 restores resolved ellipse candidate, not operation-intent refitting of arbitrary destination selections. Full fit-intent macro compatibility retains T09/T06.",
    "commercial": "Owned numeric implementation using existing geometry; original development-only observer invokes pinned ImageJ code. No new runtime/library/asset dependency."
  },
  "reference": {
    "archive": ".cache/native-verification/references/imagej154r/source.zip",
