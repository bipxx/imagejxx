  "aspects": {
    "implemented": "Explicit source-extent point promotion and current-native-row standard projection; shared ordinary/mixed export consumer and aligned import-editor topology.",
    "verified": "765 unique focused Windows product cases and 23 observation-tool checks pass; two native controls and six installed SDK clients on each Windows/Linux platform.",
    "integrated": "Physical single-ROI import/promotion/vertex edit/add/retained-source-metadata export/reopen in both Windows ImGui hosts; affected legacy/mixed/bare/rounded UI consumers pass. API cases cover ZIP/session preservation.",
    "release_ready": false
  },
  "contract": {
    "apis": [
      "annotated_imagej_point_mapping(mapped, limits)",
      "imagej_roi_annotation_projection(annotation, extent, metadata=None, limits)"
    ],
    "position_rule": "Decode retained packed words against original source extent, then validate native positions against target; never decode against rebound target shape.",
    "geometry_rule": "Changed unannotated vertices refuse inferred association; annotated edits validate/persist. Insertion adds counter0/unbound through existing SelectionEditor.",
    "projection": "Typed native annotations replace stale template counters; opaque metadata remains native. Untagged rows keep explicitly chosen wire-only counters. Fresh/default Python metadata is None.",
    "compatibility": "Existing raw codecs, map defaults and V1/V2/V3 envelope meanings unchanged. Existing explicit native replacement and V4 source archive suffice; no new serialization version or default mapping flag.",
    "source_provenance": "Retain original raw bytes/mapping independently from edited native row; no automatic source-index/current-row association.",
    "domain": "Scientific per-point positions are XY only; XZ/YZ refuse until a complete explicit representable policy is delivered."
  },
