  "state": {
    "implemented": "Public native/Python Bounding Rectangle geometry with existing admitted bounds, limits and controls; shared conversion menu/loss/history/record path. No image rasterization/provider read.",
    "verified": "45 pinned ImageJ constructor/getBounds observations;619 distinct affected Windows Python cases pass. Final two physical-host Python checks and native C++ host checks include stale-review error acknowledgement/cancel/recovery. Windows/Linux native core and installed Windows public C++ client pass.",
    "integrated": "Points/area/line/native geometry -> editable rectangle; explicit point metadata loss review/cancel, stale revision refusal without publication, Undo/Redo/workspace reopen, strict replay refusal and explicit V4 rebind.",
    "release_ready": false
  },
  "contract": {
    "api": [
      "estimate_bounding_rectangle_selection(selection,width,height,limits)",
      "bounding_rectangle_selection(selection,width,height,discard_point_metadata,limits,control)"
    ],
    "profile": "ImageJ axis-aligned box origin truncation/extent ceil; Float32 vertex ROI integer enclosing area bounds or pixel-inclusive rounded open bounds; straight Line binary64. Minimum output extent1; signed32 coordinate/extent overflow refuses rather than saturates.",
    "legacy_negative_behavior": "Pinned FloatPolygon upper bound starts at Float.MIN_VALUE; wholly nonpositive vertex upper bounds extend originward. Float32 extent subtraction before binary64 promotion is preserved and tested. Not canvas clipping.",
    "native_geometry": "Existing SelectionEditor analytic path/rotated-frame and occupied packed mask/region bounds; empty mask/region refuses. Rounded rotated kinds use outer native frame. These profiles do not qualify every ImageJ ShapeRoi/spline/source constructor.",
    "metadata": "Keep width and generic/opaque attributes. Typed point counters/positions/style require explicit discard. Selection-only history restores all original point data.",
    "reuse": "Same V4 selection-creation Replace history/recorder/rebind; shared two-operation binding and native UI driver, no new controller/cache/scheduler/schema. Existing reference fixtures/fingerprints unchanged.",
    "commercial": "Owned implementation using existing primitives; new original Java observer is development-only. No third-party dependency/runtime/asset added."
  },
