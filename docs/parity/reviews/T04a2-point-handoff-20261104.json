  "aspects": {
    "implemented": "Bounded planar read; explicit XY annotation select/store/copy-back APIs; shared ROI Manager controls and physical ZIP composition.",
    "verified": "787 unique focused Windows product cases ultimately pass;23 tool checks; two native controls and six installed SDK clients per Windows/Linux platform.",
    "integrated": "Actual both-Windows-host imported point adoption, copy-back, stored ROI Measure/Counter/Count and native export/reopen; two-member ZIP controls and affected old manager consumers.",
    "release_ready": false
  },
  "contract": {
    "apis": [
      "planar_annotations(source,max_working_bytes=None)",
      "prepare_select_planar_annotation(source,index,max_working_bytes=268435456)",
      "prepare_store_planar_annotation_roi(source,index,max_working_bytes=268435456)",
      "resolve_planar_annotation_from_selection(source,index,max_working_bytes=268435456)"
    ],
    "actions": [
      "select_planar_annotation",
      "store_planar_annotation_roi",
      "update_planar_annotation_selection"
    ],
    "ui": "ROI Manager > Plane annotations: Use as selection; Copy to ROI Manager; Replace from selection.",
    "copies": "Independent exact XY selection/attributes. Forward copies preserve planar row/provenance; explicit copy-back retains annotation name/parent positions. Selecting wildcard T/C retains view; storing retains wildcards. Explicit zero positions preserved.",
    "history": "Selection transient; storage one metadata history step; copy-back existing planar Update record. No new record grammar/live association.",
    "recording": "Copy-back existing planar record/replay; forward copies retain ROI Manager recorder gap owned by T04a.3/T12.",
    "working_limit": "Logical metadata preflight before JSON/geometry expansion; conservative decode/transfer allowance only. Existing transaction background copies, source/cache/history, allocator overhead and process RSS are outside this bound.",
    "cache": "Catalog stores index/name/plane keyed by immutable annotation binding/document/cap; unchanged selection edits reuse it.",
    "domain": "XY only; no implicit non-XY projection. Unknown point metadata remains opaque. Existing finite-scalar captured Measure domain unchanged."
  },
