  "task": "T04a.2 M2b.2b P1 scientific planar point creation defaults",
  "state": "verified_scoped",
  "base_commit": "16922f06d2b55043ee3537629e6f9ec3029085a9",
  "aspects": {
    "implemented": "Admitted native plane-aware point initialization, strict Python interface and frozen defaults/cap in the existing scientific annotation editor.",
    "verified": "664 unique focused Windows product cases ultimately pass and23 observation-tool cases; two native controls and six installed SDK clients per Windows/Linux platform.",
    "integrated": "Both Windows hosts create bound/unbound/single points on XY/XZ/YZ, cancel defaults/cap/source/navigation/escape drafts, recover and validate native records. Legacy point/multipoint/rectangle paths pass in both hosts on all three planes.",
    "release_ready": false
  },
  "contract": {
    "api": "planar_point_creation_selection(source,annotation,counter=0,capture_position=True,max_working_bytes=268435456)",
    "position_policy": "XY binds fixed row Z; XZ/YZ bind floor(vertical cell-boundary coordinate). Explicit row T/C including zero override captured view defaults; wildcards retain their parent meaning while newly bound vertices freeze the captured T/C. Reject a bound Z outside source; explicit capture-off yields an unbound point. Singleton positions remain unbound.",
    "counter_policy": "Single-point creation always uses counter0; multipoint uses captured counter0..99. Existing tagged candidates refuse implicit replacement; unrelated selection and row attributes are preserved.",
    "ui": "Existing Preferences keys now feed OrthogonalInputContext and the existing plane editor. Defaults/cap freeze at draft start; changes cancel pending new-point drafts. Existing edits do not recapture creation defaults.",
    "ownership": "Metadata-only: no source/provider image reads. API holds the GIL over immutable borrowed Python arguments so admission precedes geometry copies; native UI/SDK use the same pure core.",
    "admission": "65536 vertices; annotation staging plus existing geometric/opaque-metadata admission before owned output copies. UI reserves half for prior draft/staging and bounds new vertices. Not a complete transaction/history/provider/RSS bound.",
    "preview": "Validate only each newly clicked vertex; preview keeps existing plain geometry. Complete typed metadata is encoded once at finish, not every click/frame.",
    "recording": "Existing planar Store/Update format and source guards; native replay/session/undo/redo retain positions. No new metadata/command/envelope version or controller.",
    "non_xy_limits": "This defines native creation only. Geometry editing retains explicit point metadata under existing semantics; broader edit/rebind policy, display visibility and non-XY ImageJ ROI export remain P2/P4/T06/T10. Existing exporter refuses implicit non-XY projection."
  },
