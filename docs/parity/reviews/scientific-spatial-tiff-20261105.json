{
  "schema_version": 1,
  "date": "2026-11-05",
  "task": "Scientific navigation/reslice TIFF spatial metadata integration",
  "base_commit": "fd2dddd",
  "state": {
    "implemented": "Owned version1 TIFF spatial transform extension, strict bounded metadata parsing, complete encoded calibration estimates, shared import/export spatial details and portability notice, closed optional spatial subrecords in IO review descriptors. Existing public signatures, codecs and canonical descriptions remain unchanged.",
    "verified": "1121 distinct affected Windows Python cases ultimately pass, including36 spatial/workflow cases; final changed-UI checks pass independently. Native scientific IO/refusal/publication suites pass on Windows and Linux, including the new transform roundtrip. Native shared-form descriptor negatives and Window lifecycle regressions pass.",
    "integrated": "Native C++ and Python ImGui hosts open a scientific TCZ stack, navigate C/Z/T and XY/XZ/YZ, reslice XZ, accept actual export controls and reopen TIFF with correct pixels, origin, axis directions and time origin. IO descriptors retain the spatial metadata and reopen inert review.",
    "release_ready": false
  },
  "reproduction": "Existing XZ range reslice produced origin[0,1.25,0] and axis permutation; TIFF estimate rejected it with TIFF profile cannot encode nonzero origins/directions.",
  "contract": {
    "description_fields": {
      "imagejxx_spatial": "1",
      "imagejxx_origin": "three finite world components",
      "imagejxx_direction": "nine finite row-major values with invertible matrix",
      "imagejxx_time_origin": "finite value in declared time unit"
    },
    "compatibility": "Emit all four fields only when needed. Existing canonical files/descriptors retain their original fields. Native extension is not an ImageJ affine compatibility claim; other readers may ignore it. Existing XY rational1e-6 precision and unit normalization remain.",
    "review": "Expand Spatial origin and axis directions to inspect origin/basis/time values. Export displays a portability notice and still requires pixels/calibration-only consent. New descriptor subrecords require spatial_version1 with all fields; old four-field calibrations remain accepted.",
    "malformed": "Unsupported/partial/duplicate/spelling/vector/nonfinite/singular transforms reject during metadata inspection, before sample decode/progress. Native origin fields from unextended ImageJ inputs keep prior unsupported semantics.",
    "formats_checked": "UInt8/UInt16/Float32 classic and BigTIFF XY/XZ/YZ; additional Deflate/LZW/PackBits, RGB horizontal tiled and Float32 floating tiled, eager/virtual reads; independent description and raw native TIFF samples.",
    "licensing": "Owned implementation; no new dependency, external code, model, font or asset."
  },
